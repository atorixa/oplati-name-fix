<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="love.atorixa.oplatinamefix"
    android:versionCode="4"
    android:versionName="1.3">

    <application
        android:label="Oplati Name Fix"
        android:allowBackup="false"
        android:hasCode="true">

        <!-- Settings UI. The INFO category is deliberate: it is not shown in
             the launcher drawer, but PackageManager.getLaunchIntentForPackage()
             resolves it first, so Xposed managers still get a settings entry.
             (A LAUNCHER category would work too, at the cost of a visible icon.) -->
        <activity
            android:name=".SettingsActivity"
            android:label="Oplati Name Fix"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <!-- Read-only bridge: the hooked process of the target app cannot read
             this package's private storage, so it queries the settings here. -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="love.atorixa.oplatinamefix.config"
            android:exported="true"
            android:enabled="true" />

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="Display-only name replacement for the Oplati app. Nothing is stored or sent." />
        <meta-data android:name="xposedminversion" android:value="93" />
    </application>
</manifest>

